# .env としてコピーして使う。シークレット(APIキー等)は .env.example 側には書かない。

# --- 生成LLM (vLLM, OpenAI 互換) ---
# Port 8000 = vllm-gemma4 (Gemma 4 26B-A4B FP8)。
# --served-model-name 未指定で起動しているので、HF model ID がそのまま served name になる。
#
# LLM_PROVIDER は提供元を固定する締め金具 (2026-08-08 から実際に効くようになった)。
# vllm を指定している間は、モデル名が Azure の配備名と一致しても azure/anthropic へは
# 落ちず例外で止まる。オンプレ完結・費用最小の前提を、設定1行で保証するための行。
# クラウドの判定モデルを意図して使うときは、この行を消すか azure / anthropic にする。
LLM_PROVIDER=vllm
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=google/gemma-4-26B-A4B-it
VLLM_API_KEY=dummy
VLLM_TIMEOUT=300

# --- 埋め込み (vLLM, OpenAI 互換) ---
# Port 8003 = vllm-embed-ruri (日本語特化 768次元)。
# 代替: Port 8002 (vllm-embed-bge) を使う場合は ENDPOINT と MODEL を入れ替える。
# EMBEDDING_PROVIDER=azure にすると Azure OpenAI (下の
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME) 経由に切替わる。
EMBEDDING_PROVIDER=vllm
VLLM_EMBEDDING_ENDPOINT=http://localhost:8003/v1
VLLM_EMBEDDING_MODEL=cl-nagoya/ruri-v3-310m

# --- 判定LLM 選択A: オンプレ vLLM (推奨: 生成と別サーバ・別系統モデル) ---
# JUDGE_MODEL を設定すると filter / probe / answer-grounding / rag-verify の
# 判定既定値がこれになる (Azure より優先)。
# 生成 (:8000 Gemma) と判定は別プロセスになるので、判定サーバの base_url を
# VLLM_MODEL_ENDPOINTS (JSON: モデル名 → base_url) で振り分ける。
# 未登録モデルは VLLM_ENDPOINT に落ちる。
# 例: Nemotron を :8001 で serve する場合
# JUDGE_MODEL=nvidia/Llama-3.3-Nemotron-Super-49B-v1.5
# VLLM_MODEL_ENDPOINTS={"nvidia/Llama-3.3-Nemotron-Super-49B-v1.5": "http://localhost:8001/v1"}

# kg-generate の辺含意判定だけを別モデルへ固定する場合に指定する。
# 未指定時は Azure 配備 → JUDGE_MODEL の順。生成モデルと異なるモデルを推奨。
# KG_PROVENANCE_MODEL=gpt-4.1

# --- 判定LLM 選択B: Azure OpenAI ---
# 実値は .env 側に入れる (ここには書かない)。
# 上の LLM_PROVIDER=vllm が残っていると、判定モデル名が下の配備名と一致した時点で
# 例外になる (クラウドへ発呼しない側に倒してある)。使うなら LLM_PROVIDER を外すこと。
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# --- 判定LLM 選択C: Anthropic Claude ---
# ANTHROPIC_API_KEY=

# --- 既存 KG (Neo4j、kg-generate は読み取り専用) ---
NEO4J_URI=
NEO4J_USER=
NEO4J_PW=

# --- PDF 抽出: Azure Document Intelligence (任意) ---
# 未設定なら chunker は pypdf にフォールバックする。
AZURE_DI_ENDPOINT=
AZURE_DI_API_KEY=
AZURE_DI_MODEL=prebuilt-layout

# --- 任意: ローカル Vision/OCR 系 (rageval からは現状未参照、将来用に予約) ---
# Port 8007 = paddlex-layout (レイアウト解析サービス)
# PADDLEX_LAYOUT_ENDPOINT=http://localhost:8007
# Port 8008 = vllm-paddleocr-vl (文書OCR/レイアウト特化 ~0.9B VLM)。--served-model-name 未指定。
# PADDLEOCR_VL_ENDPOINT=http://localhost:8008/v1
# PADDLEOCR_VL_MODEL=PaddlePaddle/PaddleOCR-VL

# --- リランカー (rag-verify のスクリーニング用。本番 RAG と同じ2段構成に揃える) ---
# Port 8006 = vllm-reranker (cl-nagoya/ruri-v3-reranker-310m, /v1/rerank)
RERANK_ENDPOINT=http://localhost:8006/v1
RERANK_MODEL=cl-nagoya/ruri-v3-reranker-310m
